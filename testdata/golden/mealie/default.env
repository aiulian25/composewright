# test header

# required · from docker/docker-compose.yml:15
ALLOW_SIGNUP=false

# Logging level (e.g. critical, error, warning, info, debug)
# required · from docker/docker-compose.yml:16
LOG_LEVEL=DEBUG

# Optional: 'sqlite', 'postgres'
# required · from docker/docker-compose.yml:18
DB_ENGINE=sqlite

# required · from docker/docker-compose.yml:21
POSTGRES_USER=mealie

# secret · generated (hex32) · required · from docker/docker-compose.yml:22
POSTGRES_PASSWORD=GENERATED-POSTGRES_PASSWORD

# required · from docker/docker-compose.yml:23
POSTGRES_SERVER=postgres

# required · from docker/docker-compose.yml:24
POSTGRES_PORT=5432

# required · from docker/docker-compose.yml:25
POSTGRES_DB=mealie
