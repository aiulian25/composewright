# Override the config for logging with a custom path
# for mealie · from docs/docs/documentation/getting-started/installation/backend-config.md:20
# LOG_CONFIG_OVERRIDE=

# If specified, users belonging to this group will be made an admin. For more information see [this page](../authentication/oidc.md#groups)
# for mealie · from docs/docs/documentation/getting-started/installation/backend-config.md:111
# OIDC_ADMIN_GROUP=

# Enables authentication via OpenID Connect
# for mealie · from docs/docs/documentation/getting-started/installation/backend-config.md:104
# OIDC_AUTH_ENABLED=False

# If True, then the login page will be bypassed an you will be sent directly to your Identity Provider. You can still get to the login page by adding ?direct=1 to the login URL
# for mealie · from docs/docs/documentation/getting-started/installation/backend-config.md:112
# OIDC_AUTO_REDIRECT=False

# Configures the timeout value of the httpx client used for OIDC communications. If set to the string default, does not configure the value (uses the library's default of 5.0s). If set to the string None, disables the timeout entirely. If set to a numeric value, uses that as the timeout.
# for mealie · from docs/docs/documentation/getting-started/installation/backend-config.md:121
# OIDC_CLIENT_TIMEOUT=default

# Optional if not using OIDC_USER_GROUP or OIDC_ADMIN_GROUP. This is the claim Mealie will request from your IdP and will use to compare to OIDC_USER_GROUP or OIDC_ADMIN_GROUP to allow the user to log in to Mealie or is set as an admin. Your IdP must be configured to grant this claim
# for mealie · from docs/docs/documentation/getting-started/installation/backend-config.md:118
# OIDC_GROUPS_CLAIM=groups

# This is the claim which Mealie will use for the users Full Name
# for mealie · from docs/docs/documentation/getting-started/installation/backend-config.md:117
# OIDC_NAME_CLAIM=name

# The provider name is shown in SSO login button. "Login with <OIDC_PROVIDER_NAME\>"
# for mealie · from docs/docs/documentation/getting-started/installation/backend-config.md:113
# OIDC_PROVIDER_NAME=OAuth

# Because redirects bypass the login screen, you can't tick the "Remember Me" checkbox. Setting this to true treats an OIDC login as if it had been checked, so the session survives closing the browser
# for mealie · from docs/docs/documentation/getting-started/installation/backend-config.md:114
# OIDC_REMEMBER_ME=False

# Advanced configuration used to override the scopes requested from the IdP. Most users won't need to change this. At a minimum, 'openid profile email' are required.
# for mealie · from docs/docs/documentation/getting-started/installation/backend-config.md:119
# OIDC_SCOPES_OVERRIDE=

# The algorithm used to sign the id token (examples: RS256, HS256)
# for mealie · from docs/docs/documentation/getting-started/installation/backend-config.md:115
# OIDC_SIGNING_ALGORITHM=RS256

# Enables new users to be created when signing in for the first time with OIDC
# for mealie · from docs/docs/documentation/getting-started/installation/backend-config.md:105
# OIDC_SIGNUP_ENABLED=True

# File path to Certificate Authority used to verify server certificate (e.g. /path/to/ca.crt)
# for mealie · from docs/docs/documentation/getting-started/installation/backend-config.md:120
# OIDC_TLS_CACERTFILE=

# This is the claim which Mealie will use to look up an existing user by (e.g. "email", "preferred_username")
# for mealie · from docs/docs/documentation/getting-started/installation/backend-config.md:116
# OIDC_USER_CLAIM=email

# If specified, only users belonging to this group will be able to successfully authenticate, regardless of the OIDC_ADMIN_GROUP. For more information see [this page](../authentication/oidc.md#groups)
# for mealie · from docs/docs/documentation/getting-started/installation/backend-config.md:110
# OIDC_USER_GROUP=

# Maximum seconds FlareSolverr may spend solving a single challenge before giving up.
# for mealie · from docs/docs/documentation/getting-started/installation/backend-config.md:152
# SCRAPER_FLARESOLVERR_TIMEOUT=60

# Optional base URL of a self-hosted [FlareSolverr](https://github.com/FlareSolverr/FlareSolverr) instance (e.g. http://flaresolverr:8191). Used only as a last resort to solve JS/Cloudflare challenges. Unset disables it.
# for mealie · from docs/docs/documentation/getting-started/installation/backend-config.md:151
# SCRAPER_FLARESOLVERR_URL=

# How the proxy is used (when SCRAPER_PROXY_URL is set): always routes every request through it; fallback tries a direct request first and only retries through the proxy when a block is detected. Any unrecognized value falls back to always.
# for mealie · from docs/docs/documentation/getting-started/installation/backend-config.md:150
# SCRAPER_PROXY_MODE=always

# Optional proxy for all outbound scraping and image requests (e.g. http://user:pass@host:port). Routing through an IP with a better reputation helps bypass IP-based blocks. Unset disables it.
# for mealie · from docs/docs/documentation/getting-started/installation/backend-config.md:149
# SCRAPER_PROXY_URL=

# Maximum times a user can provide an invalid password before their account is locked
# for mealie · from docs/docs/documentation/getting-started/installation/backend-config.md:30
# SECURITY_MAX_LOGIN_ATTEMPTS=5

# Time in hours for how long a users account is locked
# for mealie · from docs/docs/documentation/getting-started/installation/backend-config.md:31
# SECURITY_USER_LOCKOUT_TIME=24

