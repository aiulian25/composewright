# test header

# (default is UTC) A [server timezone](https://www.php.net/timezones)
# required · from Docker/freshrss/docker-compose.yml:23
TZ=Europe/Paris

# (default is disabled) Define minutes for the built-in cron job to automatically refresh feeds (see below for more advanced options)
# required · from Docker/freshrss/docker-compose.yml:24
CRON_MIN=3,33

# required · from Docker/freshrss/docker-compose.yml:25
TRUSTED_PROXY='172.16.0.1/12 192.168.0.1/16'

# Optional settings the upstream documents, left unset. To use one, remove the "# "
# before it; compose.yaml already passes it to the service.

# for freshrss · from Docker/freshrss/example.env:18
# ADMIN_API_PASSWORD=

# for freshrss · from Docker/freshrss/example.env:8
# ADMIN_EMAIL=admin@example.net

# for freshrss · from Docker/freshrss/example.env:17
# ADMIN_PASSWORD=

# Address at which the FreshRSS instance will be reachable:
# for freshrss · from Docker/freshrss/example.env:21
# BASE_URL=https://freshrss.example.net

# (default is On) Copy all the logs to syslog
# for freshrss · from Docker/README.md:99
# COPY_LOG_TO_SYSLOG=

# (default is On) Copy syslog to Standard Error so that it is visible in docker logs
# for freshrss · from Docker/README.md:100
# COPY_SYSLOG_TO_STDERR=

# (default is empty, defined by ./constants.local.php or ./constants.php) Defines the path for writable data.
# for freshrss · from Docker/README.md:96
# DATA_PATH=

# Database to use
# for freshrss · from Docker/freshrss/example.env:33
# DB_BASE=freshrss

# Database server (not relevant if using default SQLite) Use the name of the Docker container if running on the same machine
# for freshrss · from Docker/freshrss/example.env:26
# DB_HOST=freshrss-db

# Password for the defined user
# for freshrss · from Docker/freshrss/example.env:39
# DB_PASSWORD=

# User in the freshrss database
# for freshrss · from Docker/freshrss/example.env:36
# DB_USER=freshrss

# (default is 1) Set to 0 to disable the Apache access log.
# for freshrss · from Docker/README.md:97
# ENABLE_ACCESS_LOG=

# (default is production) Enables additional development information if set to development (increases the level of logging and ensures that errors are displayed) (see below for more development options)
# for freshrss · from Docker/README.md:98
# FRESHRSS_ENV=

# automatically pass arguments to command line cli/do-install.php (for advanced users; see example in Docker Compose section). Only executed at the very first run (so far), so if you make any change, you need to delete your freshrss service, freshrss_data volume, before running again.
# for freshrss · from Docker/README.md:103
# FRESHRSS_INSTALL=

# automatically pass arguments to command line cli/create-user.php (for advanced users; see example in Docker Compose section). Only executed at the very first run (so far), so if you make any change, you need to delete your freshrss service, freshrss_data volume, before running again.
# for freshrss · from Docker/README.md:104
# FRESHRSS_USER=

# (default is empty, can also be set in data/config.php or under *System configuration* in Web UI) Requests to internal hosts such as 127.0.0.1 are blocked by default; here you can add overrides for which internal hosts to allow, separated by whitespace. Each host should be described either as a host…
# for freshrss · from Docker/README.md:102
# INTERNAL_HOST_ALLOWLIST=

# An opaque key used for internal encryption.
# for freshrss · from docs/en/admins/16_OpenID-Connect.md:42
# OIDC_CLIENT_CRYPTO_KEY=

# The OIDC client id from your issuer.
# for freshrss · from docs/en/admins/16_OpenID-Connect.md:40
# OIDC_CLIENT_ID=

# The OIDC client secret issuer.
# for freshrss · from docs/en/admins/16_OpenID-Connect.md:41
# OIDC_CLIENT_SECRET=

# Optional. URL the user is redirected to when the OIDC module receives a callback whose anti-CSRF state has expired or cannot be matched, for example when an interactive login (external identity provider, MFA/step-up, or the user stepping away) takes longer than the state timeout. When not defined, …
# for freshrss · from docs/en/admins/16_OpenID-Connect.md:49
# OIDC_DEFAULT_URL=

# Activates OIDC support.
# for freshrss · from docs/en/admins/16_OpenID-Connect.md:38
# OIDC_ENABLED=

# The config URL. Usually looks like: <issuer>/.well-known/openid-configuration
# for freshrss · from docs/en/admins/16_OpenID-Connect.md:39
# OIDC_PROVIDER_METADATA_URL=

# The claim to use as the username within FreshRSS. Defaults to preferred_username. Depending on what you choose here, and your identity provider, you’ll need to adjust the scopes you request so that this claim will be accessible. Refer to your identity provider’s documentation.
# for freshrss · from docs/en/admins/16_OpenID-Connect.md:43
# OIDC_REMOTE_USER_CLAIM=

# The OIDC scopes to request separated by an empty space. Defaults to openid. As mentioned previously, make sure the scopes you pick contain whatever OIDC_REMOTE_USER_CLAIM you chose. For example, Authelia would require setting this value to openid profile to make preferred_username accessible.
# for freshrss · from docs/en/admins/16_OpenID-Connect.md:44
# OIDC_SCOPES=

# Optional. Interval in seconds after which the session will be invalidated when no interaction has occurred. When not defined, the default is 300 seconds.
# for freshrss · from docs/en/admins/16_OpenID-Connect.md:46
# OIDC_SESSION_INACTIVITY_TIMEOUT=

# Optional. Maximum duration of the application session. When not defined the default is 8 hours (3600 * 8 seconds). When set to 0, the session duration will be set equal to the expiry time of the ID token.
# for freshrss · from docs/en/admins/16_OpenID-Connect.md:47
# OIDC_SESSION_MAX_DURATION=

# Optional. OpenID Connect session storage type. See [mod_auth_openidc’s documentation for details](https://github.com/OpenIDC/mod_auth_openidc/blob/72c9f479c2d228477ff0a9518964f61879c83fb6/auth_openidc.conf#L587-L596).
# for freshrss · from docs/en/admins/16_OpenID-Connect.md:48
# OIDC_SESSION_TYPE=

# Optional, but required when running FreshRSS behind a reverse proxy so that the OIDC module can determine what hostname, port and protocol were used to access FreshRSS, in order to generate a return URL for the OIDC authorization flow. Must be one or more of Forwarded, X-Forwarded-Host, X-Forwarded…
# for freshrss · from docs/en/admins/16_OpenID-Connect.md:45
# OIDC_X_FORWARDED_HEADERS=

# Published port for development or local use (optional)
# for freshrss · from Docker/freshrss/example.env:11
# PUBLISHED_PORT=8080

# for freshrss · from Docker/freshrss/example.env:22
# SERVER_DNS=freshrss.example.net
