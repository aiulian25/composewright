# test header

# Connection secret for postgres. You should change it to a random password Please use only the characters `A-Za-z0-9`, without special characters or spaces
# secret · generated (hex32) · from docker/example.env:17
DB_PASSWORD=GENERATED-DB_PASSWORD

# The values below this line do not need to be changed
# from docker/example.env:21
DB_USERNAME=postgres

# Database name
# from docker/example.env:22
DB_DATABASE_NAME=immich

# required · from docker/docker-compose.yml:64
POSTGRES_INITDB_ARGS=--data-checksums
