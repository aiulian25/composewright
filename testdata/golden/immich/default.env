# test header

# Connection secret for postgres. You should change it to a random password Please use only the characters `A-Za-z0-9`, without special characters or spaces
# secret · generated (hex32) · from docker/example.env:17
DB_PASSWORD=GENERATED-DB_PASSWORD

# The values below this line do not need to be changed
# from docker/example.env:21
DB_USERNAME=postgres

# Database name
# from docker/example.env:22
DB_DATABASE_NAME=immich

# required · from docker/docker-compose.yml:64
POSTGRES_INITDB_ARGS=--data-checksums

# Optional settings the upstream documents, left unset. To use one, remove the "# "
# before it; compose.yaml already passes it to the service.

# for immich-server · from deployment/.env:1
# CLOUDFLARE_ACCOUNT_ID=op://tf/cloudflare/account_id

# for immich-server · from deployment/.env:2
# CLOUDFLARE_API_TOKEN=

# Number of cores available to the Immich server Default: auto-detected CPU core count
# for immich-server · from docs/docs/install/environment-variables.md:42
# CPU_CORES=

# The location where your database files are stored. Network shares are not supported for the database
# for immich-server · from docker/example.env:7
# DB_DATA_LOCATION=./postgres

# Database host
# for immich-server · from docs/docs/install/environment-variables.md:80
# DB_HOSTNAME=database

# Database port
# for immich-server · from docs/docs/install/environment-variables.md:81
# DB_PORT=5432

# Whether to skip running migrations on startup (one of [true, false])
# for immich-server · from docs/docs/install/environment-variables.md:87
# DB_SKIP_MIGRATIONS=false

# Database SSL mode
# for immich-server · from docs/docs/install/environment-variables.md:85
# DB_SSL_MODE=

# Optimize concurrent IO on SSDs or sequential IO on HDDs ([SSD, HDD])<sup>\*3</sup>
# for immich-server · from docs/docs/install/environment-variables.md:88
# DB_STORAGE_TYPE=SSD

# Database URL
# for immich-server · from docs/docs/install/environment-variables.md:79
# DB_URL=

# When false disables the /auth/admin-sign-up and /admin/database-backups/start-restore endpoints
# for immich-server · from docs/docs/install/environment-variables.md:48
# IMMICH_ALLOW_SETUP=true

# Port for the OTEL metrics
# for immich-server · from docs/docs/install/environment-variables.md:43
# IMMICH_API_METRICS_PORT=8081

# Path to config file
# for immich-server · from docs/docs/install/environment-variables.md:39
# IMMICH_CONFIG_FILE=

# Environment (production, development)
# for immich-server · from docs/docs/install/environment-variables.md:35
# IMMICH_ENV=production

# Path to a json file with [helmet](https://www.npmjs.com/package/helmet) options. Set to false to disable. Set to true to use server/helmet.json<sup>\*3</sup>.
# for immich-server · from docs/docs/install/environment-variables.md:40
# IMMICH_HELMET_FILE=false

# Listening host
# for immich-server · from docs/docs/install/environment-variables.md:72
# IMMICH_HOST=0.0.0.0

# See [System Integrity](/administration/system-integrity)
# for immich-server · from docs/docs/install/environment-variables.md:47
# IMMICH_IGNORE_MOUNT_CHECK_ERRORS=

# Log output format (console, json)
# for immich-server · from docs/docs/install/environment-variables.md:37
# IMMICH_LOG_FORMAT=console

# Log level (verbose, debug, log, warn, error)
# for immich-server · from docs/docs/install/environment-variables.md:36
# IMMICH_LOG_LEVEL=log

# Media location inside the container ⚠️You probably shouldn't set this<sup>\*2</sup>⚠️
# for immich-server · from docs/docs/install/environment-variables.md:38
# IMMICH_MEDIA_LOCATION=/data

# Port for the OTEL metrics
# for immich-server · from docs/docs/install/environment-variables.md:44
# IMMICH_MICROSERVICES_METRICS_PORT=8082

# Listening port Default: 2283 (server), 3003 (machine learning)
# for immich-server · from docs/docs/install/environment-variables.md:73
# IMMICH_PORT=

# When true, generate thumbnails for invalid images
# for immich-server · from docs/docs/install/environment-variables.md:45
# IMMICH_PROCESS_INVALID_IMAGES=

# Do not collect these telemetries. List of host, api, io, repo, job
# for immich-server · from docs/docs/install/environment-variables.md:209
# IMMICH_TELEMETRY_EXCLUDE=

# Collect these telemetries. List of host, api, io, repo, job. Note: You can also specify all to enable all
# for immich-server · from docs/docs/install/environment-variables.md:208
# IMMICH_TELEMETRY_INCLUDE=

# List of comma-separated IPs set as trusted proxies
# for immich-server · from docs/docs/install/environment-variables.md:46
# IMMICH_TRUSTED_PROXIES=

# The Immich version to use. You can pin this to a specific version like "v2.1.0"
# for immich-server · from docker/example.env:13
# IMMICH_VERSION=v3

# Do not run these workers. Matches against default workers, or IMMICH_WORKERS_INCLUDE if specified.
# for immich-server · from docs/docs/install/environment-variables.md:62
# IMMICH_WORKERS_EXCLUDE=

# Only run these workers.
# for immich-server · from docs/docs/install/environment-variables.md:61
# IMMICH_WORKERS_INCLUDE=

# Enable ARM-NN hardware acceleration if supported
# for immich-server · from docs/docs/install/environment-variables.md:175
# MACHINE_LEARNING_ANN=True

# Execute operations in FP16 precision: increasing speed, reducing precision (applies only to ARM-NN)
# for immich-server · from docs/docs/install/environment-variables.md:176
# MACHINE_LEARNING_ANN_FP16_TURBO=False

# ARM-NN GPU tuning level (1: rapid, 2: normal, 3: exhaustive)
# for immich-server · from docs/docs/install/environment-variables.md:177
# MACHINE_LEARNING_ANN_TUNING_LEVEL=2

# Directory where models are downloaded
# for immich-server · from docs/docs/install/environment-variables.md:161
# MACHINE_LEARNING_CACHE_FOLDER=/cache

# Pre-allocates CPU memory to avoid memory fragmentation
# for immich-server · from docs/docs/install/environment-variables.md:183
# MACHINE_LEARNING_MODEL_ARENA=true

# Number of parallel model operations
# for immich-server · from docs/docs/install/environment-variables.md:163
# MACHINE_LEARNING_MODEL_INTER_OP_THREADS=1

# Number of threads for each model operation
# for immich-server · from docs/docs/install/environment-variables.md:164
# MACHINE_LEARNING_MODEL_INTRA_OP_THREADS=2

# Model revision to download; main selects the original exports and v2 selects the newer exports
# for immich-server · from docs/docs/install/environment-variables.md:184
# MACHINE_LEARNING_MODEL_REVISION=main

# Inactivity time (s) before a model is unloaded (disabled if \<= 0)
# for immich-server · from docs/docs/install/environment-variables.md:159
# MACHINE_LEARNING_MODEL_TTL=300

# Interval (s) between checks for the model TTL (disabled if \<= 0)
# for immich-server · from docs/docs/install/environment-variables.md:160
# MACHINE_LEARNING_MODEL_TTL_POLL_S=10

# Enable RKNN hardware acceleration if supported
# for immich-server · from docs/docs/install/environment-variables.md:181
# MACHINE_LEARNING_RKNN=True

# How many threads of RKNN runtime should be spun up while inferencing.
# for immich-server · from docs/docs/install/environment-variables.md:182
# MACHINE_LEARNING_RKNN_THREADS=1

# Maximum time (s) of unresponsiveness before a worker is killed Default: 300 (900 if using ROCm)
# for immich-server · from docs/docs/install/environment-variables.md:167
# MACHINE_LEARNING_WORKER_TIMEOUT=

# Set to true to disable color-coded log output
# for immich-server · from docs/docs/install/environment-variables.md:41
# NO_COLOR=false

# Redis DB index
# for immich-server · from docs/docs/install/environment-variables.md:117
# REDIS_DBINDEX=0

# Redis host
# for immich-server · from docs/docs/install/environment-variables.md:113
# REDIS_HOSTNAME=redis

# Redis password
# for immich-server · from docs/docs/install/environment-variables.md:116
# REDIS_PASSWORD=

# Redis port
# for immich-server · from docs/docs/install/environment-variables.md:114
# REDIS_PORT=6379

# Redis socket
# for immich-server · from docs/docs/install/environment-variables.md:112
# REDIS_SOCKET=

# Redis URL
# for immich-server · from docs/docs/install/environment-variables.md:111
# REDIS_URL=

# Redis username
# for immich-server · from docs/docs/install/environment-variables.md:115
# REDIS_USERNAME=

# for immich-server · from deployment/.env:3
# TF_STATE_POSTGRES_CONN_STR=op://tf/tf_state/postgres_conn_str

# for immich-server · from deployment/.env:4
# TF_VAR_env='$ENVIRONMENT'

# To set a timezone, uncomment the next line and change Etc/UTC to a TZ identifier from this list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones#List
# for immich-server · from docker/example.env:10
# TZ=Etc/UTC

# The location where your uploaded files are stored
# for immich-server · from docker/example.env:4
# UPLOAD_LOCATION=./library
