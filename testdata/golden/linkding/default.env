# test header

# Can be used to run linkding under a context path, for example: linkding/ Must end with a slash `/`
# from .env.sample:10
LD_CONTEXT_PATH=

# Username of the initial superuser to create, leave empty to not create one
# from .env.sample:12
LD_SUPERUSER_NAME=

# Password for the initial superuser, leave empty to disable credentials authentication and rely on proxy authentication instead
# secret · generated (password24) · from .env.sample:14
LD_SUPERUSER_PASSWORD=GENERATED-LD_SUPERUSER_PASSWORD

# Option to disable background tasks
# from .env.sample:16
LD_DISABLE_BACKGROUND_TASKS=False

# Option to disable URL validation for bookmarks completely
# from .env.sample:18
LD_DISABLE_URL_VALIDATION=False

# Enables support for authentication proxies such as Authelia
# from .env.sample:20
LD_ENABLE_AUTH_PROXY=False

# Name of the request header that the auth proxy passes to the application to identify the user See docs/Options.md for more details
# from .env.sample:23
LD_AUTH_PROXY_USERNAME_HEADER=

# The URL that linkding should redirect to after a logout, when using an auth proxy See docs/Options.md for more details
# from .env.sample:26
LD_AUTH_PROXY_LOGOUT_URL=

# Disables the login form, useful to enforce OIDC authentication
# from .env.sample:28
LD_DISABLE_LOGIN_FORM=False

# List of trusted origins from which to accept POST requests See docs/Options.md for more details
# from .env.sample:31
LD_CSRF_TRUSTED_ORIGINS=

# Database engine, can be sqlite (default) or postgres
# from .env.sample:38
LD_DB_ENGINE=

# Database name (default: linkding)
# from .env.sample:40
LD_DB_DATABASE=

# Username to connect to the database server (default: linkding)
# from .env.sample:42
LD_DB_USER=

# Password to connect to the database server
# secret · from .env.sample:44
LD_DB_PASSWORD=

# The hostname where the database is hosted (default: localhost)
# from .env.sample:46
LD_DB_HOST=

# Port use to connect to the database server Should use the default port if not set
# from .env.sample:49
LD_DB_PORT=

# Any additional options to pass to the database (default: {})
# from .env.sample:51
LD_DB_OPTIONS=

# Optional settings the upstream documents, left unset. To use one, remove the "# "
# before it; compose.yaml already passes it to the service.

# Docker container name
# for linkding · from .env.sample:2
# LD_CONTAINER_NAME=linkding

# Directory on the host system that should be mounted as data dir into the Docker container
# for linkding · from .env.sample:6
# LD_HOST_DATA_DIR=./data

# Port on the host system that the application should be published on
# for linkding · from .env.sample:4
# LD_HOST_PORT=9090

# The authorization endpoint of the OIDC provider.
# for linkding · from docs/src/content/docs/options.md:191
# OIDC_OP_AUTHORIZATION_ENDPOINT=

# The JWKS endpoint of the OIDC provider.
# for linkding · from docs/src/content/docs/options.md:194
# OIDC_OP_JWKS_ENDPOINT=

# The token endpoint of the OIDC provider.
# for linkding · from docs/src/content/docs/options.md:192
# OIDC_OP_TOKEN_ENDPOINT=

# The user info endpoint of the OIDC provider.
# for linkding · from docs/src/content/docs/options.md:193
# OIDC_OP_USER_ENDPOINT=

# The client ID of the application.
# for linkding · from docs/src/content/docs/options.md:195
# OIDC_RP_CLIENT_ID=

# The client secret of the application.
# for linkding · from docs/src/content/docs/options.md:196
# OIDC_RP_CLIENT_SECRET=

# Scopes asked for on the authorization flow. Default is oidc email profile.
# for linkding · from docs/src/content/docs/options.md:200
# OIDC_RP_SCOPES=

# The algorithm the OIDC provider uses to sign ID tokens. Default is RS256.
# for linkding · from docs/src/content/docs/options.md:197
# OIDC_RP_SIGN_ALGO=

# A custom claim to used as username for new accounts, for example preferred_username. If the configured claim does not exist or is empty, the email claim is used as fallback. Default is email.
# for linkding · from docs/src/content/docs/options.md:201
# OIDC_USERNAME_CLAIM=

# Whether to use PKCE for the OIDC flow. Default is True.
# for linkding · from docs/src/content/docs/options.md:198
# OIDC_USE_PKCE=

# Whether to verify the SSL certificate of the OIDC provider. Set to False if using self-signed certificates or custom certificate authority. Default is True.
# for linkding · from docs/src/content/docs/options.md:199
# OIDC_VERIFY_SSL=
