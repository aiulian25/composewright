# test header

# Optional settings the upstream documents, left unset. To use one, remove the "# "
# before it; compose.yaml already passes it to the service.

# Cache TTL in seconds (default: 60)
# for actual_server · from packages/cli/README.md:51
# ACTUAL_CACHE_TTL=

# Local directory for cached budget data
# for actual_server · from packages/cli/README.md:50
# ACTUAL_DATA_DIR=

# Password for end-to-end encrypted budget files
# for actual_server · from packages/cli/README.md:54
# ACTUAL_ENCRYPTION_PASSWORD=

# Budget-dir lock wait timeout in seconds (default: 10)
# for actual_server · from packages/cli/README.md:52
# ACTUAL_LOCK_TIMEOUT=

# Set to 1 to disable budget-dir locking
# for actual_server · from packages/cli/README.md:53
# ACTUAL_NO_LOCK=

# Server password (required unless using token)
# for actual_server · from packages/cli/README.md:47
# ACTUAL_PASSWORD=

# URL of the Actual sync server (required)
# for actual_server · from packages/cli/README.md:46
# ACTUAL_SERVER_URL=

# Session token (alternative to password)
# for actual_server · from packages/cli/README.md:48
# ACTUAL_SESSION_TOKEN=

# Budget Sync ID (required for most commands)
# for actual_server · from packages/cli/README.md:49
# ACTUAL_SYNC_ID=
