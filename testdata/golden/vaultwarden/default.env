# DISABLE_ADMIN_TOKEN=

# Disable icon downloading Set to true to disable icon downloading in the internal icon service. This still serves existing icons from $ICON_CACHE_FOLDER, without generating any external network requests. $ICON_CACHE_TTL must also be set to 0; otherwise, the existing icons will be deleted eventually,…
# for vaultwarden · from .env.template:252
# DISABLE_ICON_DOWNLOAD=false

# Prefer IPv6 (AAAA) resolving This settings configures the DNS resolver to resolve IPv6 first, and if not available try IPv4 This could be useful in IPv6 only environments.
# for vaultwarden · from .env.template:507
# DNS_PREFER_IPV6=false

