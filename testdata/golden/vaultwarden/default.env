# Database connection initialization Allows SQL statements to be run whenever a new database connection is created. This is mainly useful for connection-scoped pragmas. If empty, a database-specific default is used: - SQLite: "PRAGMA busy_timeout = 5000; PRAGMA synchronous = NORMAL;" - MySQL: "" - Po…
# for vaultwarden · from .env.template:103
# DATABASE_CONN_INIT=

# Database idle timeout Timeout in seconds before idle connections to the database are closed.
# for vaultwarden · from .env.template:86
# DATABASE_IDLE_TIMEOUT=600

# Database max connections Define the maximum size of the connection pool used for connecting to the database.
# for vaultwarden · from .env.template:94
# DATABASE_MAX_CONNS=10

# Database min connections Define the minimum size of the connection pool used for connecting to the database.
# for vaultwarden · from .env.template:90
# DATABASE_MIN_CONNS=2

# Database timeout Timeout when acquiring database connection
# for vaultwarden · from .env.template:82
# DATABASE_TIMEOUT=30

# Database URL When using SQLite, this should use the sqlite:// scheme followed by the path to the DB file. It defaults to sqlite://%DATA_FOLDER%/db.sqlite3. Bare paths without the sqlite:// scheme are supported for backwards compatibility, but only if the database file already exists.
# for vaultwarden · from .env.template:57
# DATABASE_URL=sqlite://data/db.sqlite3

# Main data folder This can be a path to local folder or a path to an external location depending on features enabled at build time. Possible external locations: - AWS S3 Bucket (via `s3` feature): s3://bucket-name/path/to/folder When using an external location, make sure to set TMP_FOLDER, TEMPLATES…
# for vaultwarden · from .env.template:26
# DATA_FOLDER=data

# Database connection retries Number of times to retry the database connection during startup, with 1 second delay between each retry, set to 0 to retry indefinitely
# for vaultwarden · from .env.template:78
# DB_CONNECTION_RETRIES=15

# Other MFA/2FA settings Disable 2FA remember Enabling this would force the users to use a second factor to login every time. Note that the checkbox would still be present, but ignored.
# for vaultwarden · from .env.template:607
# DISABLE_2FA_REMEMBER=false

# Enable this to bypass the admin panel security. This option is only meant to be used with the use of a separate auth layer in front
