# for vaultwarden · from .env.template:514
# SSO_ENABLED=false

# Optional Master password policy (minComplexity=[0-4]), `enforceOnLogin` is not supported at the moment.
# for vaultwarden · from .env.template:550
# SSO_MASTER_PASSWORD_POLICY=

# Prevent users from logging in directly without going through SSO
# for vaultwarden · from .env.template:517
# SSO_ONLY=false

# Activate PKCE for the Auth Code flow.
# for vaultwarden · from .env.template:540
# SSO_PKCE=true

# Authorization request scopes. Optional SSO scopes, override if email and profile are not enough (`openid` is implicit). Default: email profile
# for vaultwarden · from .env.template:534
# SSO_SCOPES=

# Allow SSO flow to create account. You probably want to disable it when using a public provider.
# for vaultwarden · from .env.template:520
# SSO_SIGNUPS_ALLOWED=true

# On SSO Signup if a user with a matching email already exists make the association
# for vaultwarden · from .env.template:523
# SSO_SIGNUPS_MATCH_EMAIL=true

# HTML template overrides data folder Must be a local path.
# for vaultwarden · from .env.template:40
# TEMPLATES_FOLDER=data/templates

# Temporary folder used for storing temporary file uploads Must be a local path.
# for vaultwarden · from .env.template:36
# TMP_FOLDER=data/tmp

# Number of days to wait before auto-deleting a trashed item. If unset (the default), trashed items are not auto-deleted. This setting applies globally, so make sure to inform all users of any changes to this setting.
# for vaultwarden · from .env.template:238
# TRASH_AUTO_DELETE_DAYS=

# Cron schedule of the job that checks for trashed items to delete permanently. Defaults to daily (5 minutes after midnight). Set blank to disable this job. Default: 0 5 0 * * *
# for vaultwarden · from .env.template:158
# TRASH_PURGE_SCHEDULE=

# Allow a burst of requests of up to this size, while maintaining the average indicated by `UNAUTHENTICATED_RATELIMIT_SECONDS`. This budget is shared between all of those endpoints, so it is more lenient than the login one.
# for vaultwarden · from .env.template:483
# UNAUTHENTICATED_RATELIMIT_MAX_BURST=50

# Number of seconds, on average, between requests from the same IP address to one of the rate limited unauthenticated endpoints, like the password hint, the account recovery mails or accessing a Send.
# for vaultwarden · from .env.template:480
# UNAUTHENTICATED_RATELIMIT_SECONDS=60

# Per-user attachment storage limit (KB) Max kilobytes of attachment storage allowed per user. When this limit is reached, the user will not be allowed to upload further attachments.
# for vaultwarden · from .env.template:229
# USER_ATTACHMENT_LIMIT=

# Per-user send storage limit (KB) Max kilobytes of send storage allowed per user. When this limit is reached, the user will not be allowed to upload further sends.
# for vaultwarden · from .env.template:233
# USER_SEND_LIMIT=

# Whether to send mail via the `sendmail` command
# for vaultwarden · from .env.template:645
# USE_SENDMAIL=false

# Logging to Syslog This requires extended logging
# for vaultwarden · from .env.template:421
# USE_SYSLOG=false

# To override the SOURCE_VERSION value. This is also used by the build.rs code for example
# for vaultwarden · from docker/README.md:188
# VW_VERSION=

# for vaultwarden · from .env.template:46
# WEB_VAULT_ENABLED=true

# for vaultwarden · from .env.template:45
# WEB_VAULT_FOLDER=web-vault/

# Yubico (Yubikey) Settings Set your Client ID and Secret Key for Yubikey OTP You can generate it here: https://upgrade.yubico.com/getapikey/ You can optionally specify a custom OTP server
# for vaultwarden · from .env.template:569
# YUBICO_CLIENT_ID=11111

# for vaultwarden · from .env.template:570
# YUBICO_SECRET_KEY=

# for vaultwarden · from .env.template:571
# YUBICO_SERVER=http://yourdomain.com/wsapi/2.0/verify
