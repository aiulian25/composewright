# test header

# required · from docker/compose/docker-compose.sqlite.yml:44
PAPERLESS_REDIS=redis://broker:6379

# required · from docker/compose/docker-compose.sqlite.yml:45
PAPERLESS_DBENGINE=sqlite

# Required. A unique secret key for session tokens and signing. Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# secret · generated (hex32) · from docker/compose/docker-compose.env:22
PAPERLESS_SECRET_KEY=GENERATED-PAPERLESS_SECRET_KEY

# Optional settings the upstream documents, left unset. To use one, remove the "# "
# before it; compose.yaml already passes it to the service.

# for webserver · from .env:1
# COMPOSE_PROJECT_NAME=paperless

# Date & time when document was added
# for webserver · from docs/advanced_usage.md:275
# DOCUMENT_ADDED=

# Path to the generate archive file (if any)
# for webserver · from docs/advanced_usage.md:277
# DOCUMENT_ARCHIVE_PATH=

# Assigned correspondent (if any)
# for webserver · from docs/advanced_usage.md:282
# DOCUMENT_CORRESPONDENT=

# Date & time when document created
# for webserver · from docs/advanced_usage.md:273
# DOCUMENT_CREATED=

# URL for document download
# for webserver · from docs/advanced_usage.md:279
# DOCUMENT_DOWNLOAD_URL=

# Formatted filename, not including paths
# for webserver · from docs/advanced_usage.md:271
# DOCUMENT_FILE_NAME=

# Database primary key of the document
# for webserver · from docs/advanced_usage.md:270
# DOCUMENT_ID=

# Date & time when document was last modified
# for webserver · from docs/advanced_usage.md:274
# DOCUMENT_MODIFIED=

# Filename of original document
# for webserver · from docs/advanced_usage.md:284
# DOCUMENT_ORIGINAL_FILENAME=

# Username of the document owner (if any)
# for webserver · from docs/advanced_usage.md:281
# DOCUMENT_OWNER=

# Original path of the consumed document
# for webserver · from docs/advanced_usage.md:218
# DOCUMENT_SOURCE_PATH=

# Comma separated list of tags applied (if any)
# for webserver · from docs/advanced_usage.md:283
# DOCUMENT_TAGS=

# Path to the generated thumbnail
# for webserver · from docs/advanced_usage.md:278
# DOCUMENT_THUMBNAIL_PATH=

# URL for the document thumbnail
# for webserver · from docs/advanced_usage.md:280
# DOCUMENT_THUMBNAIL_URL=

# The document type (if any)
# for webserver · from docs/advanced_usage.md:272
# DOCUMENT_TYPE=

# Path to a copy of the original that consumption will work on
# for webserver · from docs/advanced_usage.md:219
# DOCUMENT_WORKING_PATH=

# The default language to use for OCR. Set this to the language most of your documents are written in.
# for webserver · from docker/compose/docker-compose.env:29
# PAPERLESS_OCR_LANGUAGE=eng

# Additional languages to install for text recognition, separated by a whitespace. Note that this is different from PAPERLESS_OCR_LANGUAGE (default=eng), which defines the language used for OCR. The container installs English, German, Italian, Spanish and French by default. See https://packages.debia…
# for webserver · from docker/compose/docker-compose.env:37
# PAPERLESS_OCR_LANGUAGES=

# Use this variable to set a timezone for the Paperless Docker containers. Defaults to UTC.
# for webserver · from docker/compose/docker-compose.env:25
# PAPERLESS_TIME_ZONE=America/Los_Angeles

# This is required if you will be exposing Paperless-ngx on a public domain (if doing so please consider security measures such as reverse proxy)
# for webserver · from docker/compose/docker-compose.env:18
# PAPERLESS_URL=https://paperless.example.com

# UUID of the task used to process the new document (if any)
# for webserver · from docs/advanced_usage.md:220
# TASK_ID=

# for webserver · from docker/compose/docker-compose.env:11
# USERMAP_GID=1000

# The UID and GID of the user used to run paperless in the container. Set this to your UID and GID on the host so that you have write access to the consumption directory.
# for webserver · from docker/compose/docker-compose.env:10
# USERMAP_UID=1000
